{
  "name": "kuzens",
  "version": "1.0.0",
  "description": "Kuzens topluluk, sohbet ve sesli iletişim uygulaması",
  "main": "desktop/main.cjs",
  "author": "Kuzens",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern release",
    "db:generate": "drizzle-kit generate",
    "version": "node desktop/sync-version.cjs && git add desktop/package.json",
    "desktop:dev": "electron desktop/main.cjs",
    "desktop:dir": "electron-builder --dir --win",
    "desktop:package": "electron-builder --win nsis portable --publish never",
    "desktop:web-installer": "electron-builder --win nsis-web --publish never",
    "desktop:store": "electron-builder --config desktop/electron-builder.store.cjs --win appx --publish never",
    "desktop:release": "electron-builder --win nsis-web portable --publish always"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "firebase": "^12.17.0",
    "jose": "^6.2.7",
    "next": "^16.2.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.50.0",
    "@cloudflare/workers-types": "^5.20260801.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "electron": "41.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.2.11",
    "react-server-dom-webpack": "^19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "^8.2.0",
    "wrangler": "^4.118.0"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  },
  "type": "module",
  "build": {
    "appId": "com.kuzens.chat",
    "productName": "Kuzens",
    "copyright": "Copyright © 2026 Kuzens. Tüm hakları saklıdır.",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "app": "desktop",
      "output": "release"
    },
    "files": [
      "main.cjs",
      "offline.html",
      "icon-512.png",
      "package.json"
    ],
    "win": {
      "icon": "public/icon-512.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "Kuzens-Kurulum-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Kuzens",
      "uninstallDisplayName": "Kuzens"
    },
    "nsisWeb": {
      "artifactName": "Kuzens-Web-Kurulum-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Kuzens"
    },
    "portable": {
      "artifactName": "Kuzens-Portable-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Mustafa852",
        "repo": "Kuzens",
        "releaseType": "release"
      }
    ]
  }
}
